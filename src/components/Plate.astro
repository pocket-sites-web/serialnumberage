---
// Generic data plate drawing (our own artwork, no brand marks) with the serial number highlighted.
interface Props { serial: string; kind: string; caption: string }
const { serial, kind, caption } = Astro.props;
---
<figure class="plate-fig">
  <svg viewBox="0 0 420 200" role="img" aria-label={`Drawing of a ${kind} data plate with the serial number ${serial} highlighted`}>
    <rect x="1" y="1" width="418" height="198" rx="10" fill="var(--plate)" stroke="var(--plate-edge)" stroke-width="2" />
    <circle cx="16" cy="16" r="4" fill="var(--plate-edge)" /><circle cx="404" cy="16" r="4" fill="var(--plate-edge)" />
    <circle cx="16" cy="184" r="4" fill="var(--plate-edge)" /><circle cx="404" cy="184" r="4" fill="var(--plate-edge)" />
    <text x="210" y="34" text-anchor="middle" font-family="var(--font-display)" font-weight="800" font-size="15" fill="var(--plate-ink)">{kind.toUpperCase()}</text>
    <line x1="30" y1="46" x2="390" y2="46" stroke="var(--plate-edge)" />
    <text x="30" y="72" font-family="var(--font-sans)" font-size="11" fill="var(--plate-ink)" opacity=".7">MODEL NO.</text>
    <rect x="30" y="78" width="200" height="12" rx="2" fill="var(--plate-edge)" opacity=".7" />
    <text x="30" y="114" font-family="var(--font-sans)" font-size="11" font-weight="700" fill="var(--brand)">SERIAL NO.</text>
    <rect x="26" y="119" width="250" height="32" rx="4" fill="none" stroke="var(--brand)" stroke-width="2.5" />
    <text x="36" y="142" font-family="var(--font-mono)" font-weight="600" font-size="20" letter-spacing="2" fill="var(--plate-ink)">{serial}</text>
    <rect x="300" y="64" width="90" height="10" rx="2" fill="var(--plate-edge)" opacity=".6" />
    <rect x="300" y="82" width="70" height="10" rx="2" fill="var(--plate-edge)" opacity=".6" />
    <rect x="300" y="100" width="80" height="10" rx="2" fill="var(--plate-edge)" opacity=".6" />
    <rect x="30" y="166" width="150" height="9" rx="2" fill="var(--plate-edge)" opacity=".5" />
    <rect x="200" y="166" width="120" height="9" rx="2" fill="var(--plate-edge)" opacity=".5" />
  </svg>
  <figcaption>{caption}</figcaption>
</figure>
